{
  "name": "@bitspv/tokens",
  "version": "0.1.1",
  "description": "BitSPV 品牌 token：颜色/字体/间距/圆角/动效的唯一来源，产出 CSS 变量与 Tailwind preset。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:cyio/bitspv-platform.git",
    "directory": "packages/tokens"
  },
  "bin": {
    "bitspv-tokens": "./bin/cli.mjs"
  },
  "exports": {
    ".": "./tokens.json",
    "./tokens.json": "./tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-preset.cjs": "./tailwind-preset.cjs",
    "./build": "./src/build.mjs",
    "./tailwind-v4.css": "./tailwind-v4.css"
  },
  "files": [
    "tokens.json",
    "dist/tokens.css",
    "tailwind-preset.cjs",
    "tailwind-v4.css",
    "src/build.mjs",
    "src/audit.mjs",
    "bin/cli.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "node bin/cli.mjs build",
    "preset": "node bin/cli.mjs preset",
    "audit": "node bin/cli.mjs audit"
  }
}
